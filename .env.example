# ---- Database (real credentials live in .env, never in source) ----
# Local Postgres:
#   DATABASE_URL=postgresql+psycopg://postgres:<url-encoded-password>@localhost:5432/DAT
# Neon (serverless Postgres) — use the `postgresql+psycopg://` scheme:
#   DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/DAT

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000

# ---- Authentication ----
# Secret used to sign session cookies. Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---- LLM provider abstraction ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- App ----
ENVIRONMENT=development
